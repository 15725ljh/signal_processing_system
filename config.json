// ============================================================================
//  雷达信号处理系统 - 参数配置文件
//  Radar Signal Processing System - Parameter Configuration
// ============================================================================
//
//  使用说明:
//    1. 本文件采用 JSON 格式，支持 // 和 # 行注释
//    2. 所有参数均可选，未设置的字段自动使用代码中的默认值
//    3. 数值支持科学计数法，如 16e9 表示 16 x 10^9
//    4. 删除或注释掉某行即恢复该参数的默认值
//    5. 修改后保存文件，下次运行程序时自动生效，无需重新编译
//
//  智能寻址顺序（找到第一个即停止）:
//    1. 环境变量 SPS_CONFIG 指定的路径
//    2. 可执行文件同目录: ./config.json
//    3. 项目根目录:     ../config.json
//    4. 用户配置目录:   ~/.config/sps/config.json
//    5. 以上均未找到 → 使用全部默认值，控制台输出提示
//
// ============================================================================

{
    // ======================== 系统基本参数 ========================
    // 以下参数为 01/02/04 三个模块共享的系统常数
    // 对应代码: parameters.h
    // 修改这些参数会影响所有模块的计算结果
    "system": {
        "fc":    16e9,         // 载波频率 (Hz)            Ku波段，默认 16 GHz
        "Tp":    12e-6,        // 脉冲宽度 (s)             默认 12 us
        "B":     40e6,         // 信号带宽 (Hz)            默认 40 MHz
        // "fs":  null,        // 采样频率 (Hz)            默认 3*B = 120 MHz，设为 null 或不填则自动计算
        "prf":   10e3,         // 脉冲重复频率 (Hz)        默认 10 kHz
        "Vr":    50,           // 雷达-目标径向速度 (m/s)  默认 50 m/s
        "Rs":    10000,        // 场景中心斜距 (m)         默认 10 km
        "wr":    608,          // 场景距离向宽度 (m)       默认 608 m
        "A_RJ":  10,           // 干扰幅度增益 (dB)        全局默认值，各 Case 可单独覆盖
        "z_R0":  2000,         // 雷达初始高度 z坐标 (m)   默认 2000 m
        "nan1":  64            // 方位向脉冲数 (慢时间)    默认 64
        // "point_num": 1,     // 目标点数                 默认 1
    },

    // ======================== 01 波形生成模块 ========================
    // 对应代码: Module1.h 中 boxing_Case1 ~ boxing_Case5
    "waveform": {
        // Case 1: 固定跳频波形
        "case1_freq_hop": {
            "N":         10,          // 跳频点数               随机选择 1~N 的频点
            "delta_f":   null        // 频率步进 (Hz)          默认 B (40 MHz)，null 则使用系统带宽
        },

        // Case 3: 脉冲重复间隔抖动波形
        "case3_pri_jitter": {
            "prt":       1000e-6,     // 标称脉冲重复间隔 (s)   默认 1000 us
            "amp":       1,           // 信号幅度               默认 1
            "jitter_us": 20          // 抖动范围 (+-us)        默认 +-20 us
        },

        // Case 4: 混合波形 (跳频 + 脉冲抖动)
        "case4_hybrid": {
            "delta_f":   null,        // 频率步进 (Hz)          默认 B
            "fcnum":     16,          // 载频分组数             默认 16
            "prt":       1000e-6,     // 标称脉冲重复间隔 (s)   默认 1000 us
            "amp":       1,           // 信号幅度               默认 1
            "jitter_us": 20          // 抖动范围 (+-us)        默认 +-20 us
        },

        // Case 5: 跳频 + 随机相位复合波形
        "case5_combined": {
            "N":         10,          // 跳频点数               默认 10
            "delta_f":   null        // 频率步进 (Hz)          默认 B
        }
    },

    // ======================== 02 干扰生成模块 ========================
    // 对应代码: Module2.h 中 ganrao_Case1 ~ ganrao_Case10
    // 每种干扰模式的独立参数，覆盖对应 Case 函数中的硬编码默认值
    "jamming": {

        // ----------------------------------------------------------
        // Case 1: 距离假目标干扰 (RDJ - Range Deception Jamming)
        // 原理: 通过频域相位调制模拟不同距离的虚假目标回波
        // ----------------------------------------------------------
        "case1_rdj": {
            "jj":       1,            // 干扰脉冲延迟数         对前向脉冲信号延迟后叠加，1=延迟1个脉冲
            "Rj":       100,          // 干扰目标距离 (m)       假目标距雷达的距离
            "amp_j":    10           // 干扰信号幅度增益 (线性倍数)  直接乘以干扰信号，非dB
        },

        // ----------------------------------------------------------
        // Case 2: 速度假目标干扰 (VDJ - Velocity Deception Jamming)
        // 原理: 通过多普勒调制在速度维产生虚假目标
        // ----------------------------------------------------------
        "case2_vdj": {
            "Vj":       1e5,          // 假目标速度 (m/s)       100 km/s，超出雷达速度盲区
            "jj":       1,            // 干扰延迟脉冲数
            "Rj":       10,           // 假目标距离 (m)
            "amp_j":    10           // 干扰信号幅度增益 (线性倍数)  直接乘以干扰信号，非dB
        },

        // ----------------------------------------------------------
        // Case 3: 间歇采样转发干扰 (ISRJ - Interrupted Sampling
        //         Repeater Jamming)
        // 原理: 周期性采样+切片重组，产生距离-多普勒联合欺骗
        // ----------------------------------------------------------
        "case3_isrj": {
            "Ts_ISRJ":  4e-6,         // 采样周期 (s)           4 us，满足 Ts > 1/B
            "T_ISRJ":   null,         // 采样脉宽 (s)           默认 Ts_ISRJ/4 = 1 us
            "Rj":       10,           // 干扰目标距离 (m)
            "amp_j":    10           // 干扰信号幅度增益 (线性倍数，非 dB)
        },

        // ----------------------------------------------------------
        // Case 4: 窄带噪声干扰 (NNJ - Narrowband Noise Jamming)
        // 原理: 带限高斯噪声降低接收机信噪比，遮盖真实目标
        // ----------------------------------------------------------
        "case4_nnj": {
            "power_dBW": 20,          // 噪声功率 (dBW)         20 dBW → 线性功率 100
            "butter_order": 8,        // 低通滤波器阶数         8阶 Butterworth
            "butter_cutoff": 0.3     // 归一化截止频率         0.3 = 奈奎斯特频率的30%
        },

        // ----------------------------------------------------------
        // Case 5: 距离波门拖引干扰 (RGPO - Range Gate Pull-Off)
        // 原理: 渐进改变假目标距离，诱使雷达距离跟踪波门偏离
        //       三阶段: 捕获(k=0) → 拖引(k<4) → 反转(k>=4)
        // ----------------------------------------------------------
        "case5_rgpo": {
            "Vj":           340,      // 假目标拖引速度 (m/s)   340 m/s (约音速)
            "amp_target":   1.0,      // 目标幅度               默认 1.0
            "amp_jammer":   1.4,      // 干扰幅度               1.4 ≈ +3 dB 优于目标
            "drag_stages":  4,        // 拖引阶段次数           前N个脉冲执行拖引
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB) 目标和干扰信号均加噪
        },

        // ----------------------------------------------------------
        // Case 6: 速度波门拖引干扰 (VGPO - Velocity Gate Pull-Off)
        // 原理: 在速度维渐进制造虚假运动，破坏雷达速度跟踪
        // ----------------------------------------------------------
        "case6_vgpo": {
            "Vj":           1e4,      // 假目标速度 (m/s)       10 km/s
            "amp_target":   1.0,      // 目标幅度
            "amp_jammer":   1.4,      // 干扰幅度
            "drag_stages":  4,        // 拖引阶段次数
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB)
        },

        // ----------------------------------------------------------
        // Case 7: 密集复制转发假目标干扰 (DRFTJ - Dense Repeater
        //         False Target Jamming)
        // 原理: 在真实目标附近产生多个等间隔假目标群
        // ----------------------------------------------------------
        "case7_drftj": {
            "JSR":          0,        // 干信比 (dB)            0 dB = 干扰与目标等幅
            "amp_target":   1.0,      // 目标幅度
            "num_jam":      50,       // 转发次数               产生50个假目标
            "detaR":        50,       // 每次转发距离增量 (m)   需大于距离分辨率 c/(2B)≈3.75m
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB)
        },

        // ----------------------------------------------------------
        // Case 8: 脉内前沿切片重复假目标干扰 (IPLESRJ)
        // 原理: 对雷达脉冲前沿进行切片重复转发
        // 注意: 此模式使用独立的距离参数体系 (R0_new)，与全局 Rs 不同
        // ----------------------------------------------------------
        "case8_iplesrj": {
            "A_RJ":         30,       // 干扰机发射功率增益 (dB) 30 dB → 线性幅度 ~31.6
            "amp_target":   1.0,      // 目标幅度
            "R0_new":       608,      // 雷达-目标初始距离 (m)   独立参数，不同于全局 Rs=10000
            "V_ISRJ":       0,        // 雷达-干扰机径向速度 (m/s)
            "T_ISRJ_ratio": null,     // 干扰间隔 = Tp / 此值    默认 16 (即 Tp/16)
            "R_ahead":      0,        // 干扰机提前发射时间 (s)
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB)
        },

        // ----------------------------------------------------------
        // Case 9: 频谱弥散干扰 (SMSP - Spectral-Matched Spread
        //         Spectrum Jamming)
        // 原理: 将脉冲等分为多段，每段使用增强的调频率，使脉压后
        //       假目标在距离维弥散，降低雷达检测性能
        // ----------------------------------------------------------
        "case9_smsp": {
            "R0":           10000,    // 目标初始距离 (m)        10 km
            "num_slices":   4,        // 频谱切片次数           脉冲被等分为4段
            "JSR":          15,       // 干信比 (dB)            15 dB
            "amp_target":   1.0,      // 目标幅度
            "amp_extra":    1.4,      // 干扰幅度额外系数       最终幅度 = amp_target * 10^(JSR/20) * 此值
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB)
        },

        // ----------------------------------------------------------
        // Case 10: 梳状谱干扰 (COMB - Comb Spectrum Jamming)
        // 原理: 在信号带宽内产生多个等间隔的窄带干扰谱线
        // ----------------------------------------------------------
        "case10_comb": {
            "R0":           10000,    // 目标初始距离 (m)        10 km
            "num_tones":    7,        // 频谱线数量             奇数为佳，保证对称
            "JSR":          0,        // 干信比 (dB)            0 dB
            "amp_target":   1.0,      // 目标幅度
            "deltaf":       1e6,      // 频率间隔 (Hz)          1 MHz
            "awgn_snr":     10       // 加性高斯白噪信噪比 (dB)
        }
    },

    // ======================== 04 信号处理模块 ========================
    // 对应代码: Module3.h 中 chuli_Case1 ~ chuli_Case6
    "processing": {
        // Case 3/4: Kaiser窗参数
        "kaiser_beta": 8,             // Kaiser窗 beta 参数     8 → 旁瓣抑制约 -60 dB

        // Case 4: 改进型脉冲压缩的频率步进
        "case4_delta_f": null,        // 频率跳变步进 (Hz)      默认 B

        // Case 6: 时频干扰解耦参数(04模块自适应,覆盖detection_suppression.*节)
        "divi_stft_num":   256,        // 分离STFT频点数
        "divi_hamming_len": 63,        // 分离汉明窗长度(63>31,提供更好的频率分辨率)
        "tsallis_q": 1.0,        // Tsallis熵参数 q (04模块: 1.0=Shannon熵,对3×过采样信号更稳定)
        "gaojiepu_threshold": 5.0     // 高阶谱判定阈值 (04模块: 信号幅度~1, 降低阈值)
    },

    // ======================== 04 干扰识别模块 ========================
    // 对应代码: Module2.5.h 中 gr_detection()
    "recognition": {
        "stft_num":       256,        // STFT 频点数
        "hamming_len":    63,         // 汉明窗长度
        "threshold_ratio": 0.3,       // 二值化阈值系数         miu1 = mean * 此值
        "periodic_std1":  25,         // 上边界周期性判定阈值   std_J_Ts1 < 此值 → 有周期性
        "periodic_std2":  6,          // 下边界周期性判定阈值   std_J_Ts2 < 此值 → 有周期性
        "pulse_count_threshold": 10,  // 脉冲数分类阈值         < 此值→密集假目标, >=→频谱弥散
        "bw_ratio_threshold": 1.5    // 带宽比分类阈值         < 此值→灵巧噪声, >=→窄带
    },

    // ======================== 03 干扰检测抑制模块 ========================
    // 注意: 03模块使用独立的参数体系 (fc=35GHz, B=80MHz, Rs=1000m)
    // 对应代码: 03_jamming_detection_suppression/include/
    "detection_suppression": {
        // -- 基本系统参数 (对应 EchoGenerator.h / main.cpp) --
        "fc":              35e9,       // 载波频率 (Hz)          Ka波段 35 GHz（不同于全局16GHz）
        "B":               80e6,       // 信号带宽 (Hz)          80 MHz（不同于全局40MHz）
        "R0":              1000,       // 目标初始距离 (m)       1 km（不同于全局10km）
        "prf":             5e3,        // 脉冲重复频率 (Hz)      5 kHz
        "Tp":              12e-6,      // 脉冲宽度 (s)
        "fs":              120e6,      // 采样频率 (Hz)
        "nrn":             2048,       // 信号采样点数
        "cpiNum":          100,        // CPI 数量（脉冲数）
        "SNR":             25,         // 信噪比 (dB)            目标回波加噪
        "JSR":             30,         // 干信比 (dB)            干扰信号幅度
        "noise_snr":       25,         // 混合信号底噪 SNR (dB)  混合后再次加噪的信噪比
        "r_min_ratio":     0.7,        // 干扰距离下限比例       R1_options 范围 = r_min_ratio*R0 ~ r_max_ratio*R0
        "r_max_ratio":     1.7,        // 干扰距离上限比例

        // -- 干扰识别参数 (对应 GrDetection.h) --
        "gr_stft_num":     256,        // 识别STFT频点数
        "gr_hamming_len":  63,         // 识别汉明窗长度

        // -- 干扰目标分离参数 (对应 JamTarDivi.h) --
        "divi_stft_num":   256,        // 分离STFT频点数
        "divi_hamming_len": 31,        // 分离汉明窗长度
        "tsallis_q": 1.2,        // Tsallis熵参数 q        03模块独立值（全局为1.5）
        "gaojiepu_threshold": 35,      // 高阶谱判定阈值         mean_abs_target < 此值 → 标记

        // -- 时频分析参数 (对应 TfrStft.h) --
        "scale_factor":    32768,      // STFT缩放因子           pow(2,15)

        // -- 干扰生成器参数 (对应 JammingSimulator.h) --
        "iscj_sub_T":      1e-6,       // ISCJ 子脉冲宽度 (s)
        "isdj_sub_Ts":     2e-6,       // ISDJ 重复周期 (s)
        "isrj_sub_Ts":     4e-6,       // ISRJ 重复周期 (s)
        "nbj_center_freq": 15e6,       // NBJ 频带中心偏移 (Hz)  调制频率
        "nbj_noise_std":   5.0,        // NBJ 高斯噪声标准差     sqrt(此值)
        "nbj_filter_order": 8         // NBJ 滤波器指数阶       巴特沃斯滤波器 2*阶
    }
}
