{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(cmake:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(chmod:*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "defaultShell": "bash",
  "language": "chinese",
  "alwaysThinkingEnabled": true,
  "autoCompactWindow": 850000,
  "fastMode": true,
  "autoMemoryEnabled": true,
  "showThinkingSummaries": true,
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"tool\":\"$CLAUDE_TOOL_NAME\",\"time\":\"$(date -Iseconds)\"}' >> ~/.claude/tool-log.jsonl 2>/dev/null || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
